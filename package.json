{
  "name": "luma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build && pnpm --filter @luma/api run build && pnpm --filter @luma/web run build",
    "dev": "pnpm --parallel --filter @luma/api --filter @luma/web run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "pnpm format:check",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @luma/database run migrate",
    "db:generate": "pnpm --filter @luma/database run generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.9"
  }
}
